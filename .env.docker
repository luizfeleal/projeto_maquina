# =============================================================================
# .env.docker — Template de variáveis de ambiente para o Docker
# Projeto: SwiftPay / ProjetoMaquina
# =============================================================================
#
# INSTRUÇÕES:
#   1. Copie este arquivo como .env:  cp .env.docker .env
#   2. Preencha os valores marcados com <PREENCHER>
#   3. NUNCA commite o .env no git (já está no .gitignore do Laravel)
#
# Diferenças em relação ao .env.example padrão:
#   - DB_HOST=db        (hostname do serviço MySQL no Docker, não 127.0.0.1)
#   - REDIS_HOST=redis  (hostname do serviço Redis no Docker)
#   - CACHE_DRIVER=redis (usa Redis para cache do token da API externa)
#   - SESSION_DRIVER=redis (opcional, mais performático que `file`)
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação Laravel
# -----------------------------------------------------------------------------
APP_NAME="SwiftPay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# -----------------------------------------------------------------------------
# API Mock — desenvolvimento sem API externa
# Com API_MOCK_ENABLED=true, não é necessário configurar APP_URL_API.
# Login mock: admin/admin123 (admin) | cliente/cliente123 (cliente)
# -----------------------------------------------------------------------------
API_MOCK_ENABLED=true
API_MOCK_PERSIST=true

# -----------------------------------------------------------------------------
# API Externa (obrigatório quando API_MOCK_ENABLED=false)
# -----------------------------------------------------------------------------
APP_URL_API=<PREENCHER: URL_DA_API_EXTERNA>
EMAIL_API=<PREENCHER: EMAIL_DE_AUTENTICACAO_DA_API>
PASSWORD_API=<PREENCHER: SENHA_DE_AUTENTICACAO_DA_API>

# -----------------------------------------------------------------------------
# Banco de Dados Local (MySQL no Docker)
# DB_HOST deve ser o nome do serviço no docker-compose.yml
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=projeto_maquina
DB_USERNAME=laravel
DB_PASSWORD=laravel

# Senha do root (usada no healthcheck do docker-compose.yml)
DB_ROOT_PASSWORD=root_secret

# Porta exposta no host para acesso via GUI (DBeaver, TablePlus, etc.)
DB_EXTERNAL_PORT=3306

# -----------------------------------------------------------------------------
# Redis (usado para cache do token da API e, opcionalmente, sessões)
# REDIS_HOST deve ser o nome do serviço no docker-compose.yml
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Cache e Sessão
# redis: melhor opção no Docker (evita problemas de permissão em storage/framework)
# file: funciona também, mas depende das permissões do entrypoint.sh
# -----------------------------------------------------------------------------
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Filas (sync = executa inline, sem worker separado)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Email (Mailhog para desenvolvimento — captura emails sem enviar)
# Para usar Mailhog: adicione o serviço mailhog ao docker-compose.yml
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@swiftpay.local
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Docker — Portas do host
# Ajuste se as portas padrão estiverem em uso na sua máquina
# -----------------------------------------------------------------------------
APP_PORT=80
MIX_HMR_PORT=8080

# -----------------------------------------------------------------------------
# Docker — UID/GID do usuário (para evitar problemas de permissão no Linux)
# No macOS com Docker Desktop: mantenha 1000/1000
# No Linux: substitua pelo valor de `id -u` e `id -g` no seu terminal
# -----------------------------------------------------------------------------
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# Laravel Mix HMR (Hot Module Replacement)
# Define que o webpack.mix.js deve usar a configuração para Docker
# -----------------------------------------------------------------------------
RUNNING_IN_DOCKER=true
MIX_HMR_PORT=8080

# -----------------------------------------------------------------------------
# Variáveis herdadas do .env.example (mantidas por compatibilidade)
# -----------------------------------------------------------------------------
MIX_PUSHER_APP_KEY=
MIX_PUSHER_APP_CLUSTER=mt1
